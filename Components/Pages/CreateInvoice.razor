
@page "/create-invoice"
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Create Invoice</PageTitle>

<h1>Create Sales Invoice</h1>
<p>Create invoices using customers and products from SQL Server.</p>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

@if (isLoading)
{
    <p>Loading customers and products...</p>
}
else
{
    <div class="card p-4 mb-4 shadow-sm">
        <h4>Customer Information</h4>

        <label class="form-label mt-3">Select Customer</label>

        <div class="d-flex flex-wrap gap-2">
            <select class="form-select flex-grow-1"
                    style="width: 220px"
                    @bind="selectedCustomerId"
                    disabled="@(isSaving || isSavingCustomer || isDeletingCustomer || showDeleteCustomerConfirmation)">

                <option value="0">-- Choose a customer --</option>

                @foreach (var customer in customers)
                {
                    <option value="@customer.CustomerId">
                        @customer.Name
                    </option>
                }
            </select>

            <button class="btn btn-outline-primary"
                    disabled="@(isSaving || isSavingCustomer || isDeletingCustomer || showDeleteCustomerConfirmation)"
                    @onclick="ToggleCustomerForm">
                @(showCustomerForm ? "Cancel" : "+ New Customer")
            </button>

            <button class="btn btn-outline-danger"
                    disabled="@(selectedCustomerId == 0 || isSaving || isSavingCustomer || isDeletingCustomer || showCustomerForm)"
                    @onclick="ShowDeleteCustomerConfirmation">
                Delete Customer
            </button>
        </div>

        @if (showCustomerForm)
        {
            <div class="border rounded p-3 mt-4">
                <h5 class="mb-3">Add New Customer</h5>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Customer Name</label>

                        <input type="text"
                               class="form-control"
                               placeholder="Enter customer name"
                               @bind="newCustomerName"
                               disabled="@isSavingCustomer" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Email</label>

                        <input type="email"
                               class="form-control"
                               placeholder="Enter email"
                               @bind="newCustomerEmail"
                               disabled="@isSavingCustomer" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Phone Number</label>

                        <input type="tel"
                               class="form-control"
                               placeholder="Enter phone number"
                               @bind="newCustomerPhone"
                               disabled="@isSavingCustomer" />
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-success"
                            disabled="@isSavingCustomer"
                            @onclick="SaveCustomer">
                        @(isSavingCustomer ? "Saving..." : "Save Customer")
                    </button>

                    <button class="btn btn-outline-secondary"
                            disabled="@isSavingCustomer"
                            @onclick="CancelCustomerForm">
                        Cancel
                    </button>
                </div>
            </div>
        }

        @if (showDeleteCustomerConfirmation)
        {
            <div class="alert alert-warning mt-4">
                <h5>Confirm Customer Deletion</h5>

                <p>
                    Are you sure you want to delete customer
                    <strong>@customerToDeleteName</strong>?
                </p>

                <p>
                    Customers with existing invoices cannot be deleted.
                    This action cannot be undone.
                </p>

                <div class="d-flex gap-2">
                    <button class="btn btn-danger"
                            disabled="@isDeletingCustomer"
                            @onclick="DeleteCustomer">
                        @(isDeletingCustomer ? "Deleting..." : "Yes, Delete Customer")
                    </button>

                    <button class="btn btn-secondary"
                            disabled="@isDeletingCustomer"
                            @onclick="CancelCustomerDeletion">
                        Cancel
                    </button>
                </div>
            </div>
        }
    </div>

    <div class="card p-4 mb-4 shadow-sm">
        <h4>Invoice Products</h4>

        @foreach (var line in invoiceLines)
        {
            <div class="row g-3 align-items-end mb-3" @key="line">

                <div class="col-md-4">
                    <label class="form-label">Product</label>

                    <select class="form-select"
                            @bind="line.ProductId"
                            disabled="@isSaving">

                        <option value="0">-- Choose a product --</option>

                        @foreach (var product in products)
                        {
                            <option value="@product.ProductId">
                                @product.Name - EGP @product.Price.ToString("N2")
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Quantity</label>

                    <input type="number"
                           min="1"
                           step="1"
                           class="form-control"
                           @bind="line.Quantity"
                           @bind:event="oninput"
                           disabled="@isSaving" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Discount %</label>

                    <input type="number"
                           min="0"
                           max="100"
                           step="0.01"
                           class="form-control"
                           @bind="line.DiscountPercent"
                           @bind:event="oninput"
                           disabled="@isSaving" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Line Total</label>

                    <div class="form-control bg-light">
                        EGP @GetLineTotal(line).ToString("N2")
                    </div>
                </div>

                <div class="col-md-2">
                    <button class="btn btn-outline-danger w-100"
                            disabled="@isSaving"
                            @onclick="() => RemoveLine(line)">
                        Remove
                    </button>
                </div>
            </div>
        }

        <button class="btn btn-outline-primary"
                disabled="@isSaving"
                @onclick="AddLine">
            + Add Product
        </button>
    </div>

    <div class="card p-4 shadow-sm">
        <h4>Invoice Summary</h4>
        <hr />

        <div class="d-flex justify-content-between mb-2">
            <span>Subtotal Before Discounts</span>
            <span>EGP @OriginalSubtotal.ToString("N2")</span>
        </div>

        <div class="d-flex justify-content-between mb-2">
            <span>Total Item Discounts</span>
            <span>
                - EGP @TotalItemDiscounts.ToString("N2")
            </span>
        </div>

        <div class="d-flex justify-content-between mb-3">
            <span>Subtotal After Item Discounts</span>
            <strong>
                EGP @SubtotalAfterItemDiscounts.ToString("N2")
            </strong>
        </div>

        <div class="row align-items-end mb-3">
            <div class="col-md-4">
                <label class="form-label">Invoice Discount %</label>

                <input type="number"
                       min="0"
                       max="100"
                       step="0.01"
                       class="form-control"
                       @bind="invoiceDiscountPercent"
                       @bind:event="oninput"
                       disabled="@isSaving" />
            </div>

            <div class="col-md-8">
                <div class="d-flex justify-content-between mt-3">
                    <span>Invoice Discount Amount</span>
                    <span>
                        - EGP @InvoiceDiscountAmount.ToString("N2")
                    </span>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between mb-2">
            <span>Total Before Rounding</span>
            <span>EGP @TotalBeforeRounding.ToString("N2")</span>
        </div>

        <div class="d-flex justify-content-between mb-2">
            <span>Automatic Rounding Discount</span>
            <span>- EGP @RoundingDiscount.ToString("N2")</span>
        </div>

        <div class ="d-flex justify-content-between mb-2">
            <strong>Total Discount (%)</strong>
            <strong class= "text-success">
                @TotalDiscountPercent.ToString("N2")%
            </strong>
        </div>


        <hr />

        <div class="d-flex justify-content-between">
            <h5>Final Invoice Total</h5>

            <h4 class="text-primary">
                EGP @InvoiceTotal.ToString("N2")
            </h4>
        </div>

        <button class="btn btn-primary btn-lg mt-3"
                disabled="@(isSaving || isSavingCustomer || isDeletingCustomer || showDeleteCustomerConfirmation)"
                @onclick="CreateInvoiceAsync">
            @(isSaving ? "Saving..." : "Create Invoice")
        </button>
    </div>
}

@code {
    private List<CustomerDto> customers = new();
    private List<ProductDto> products = new();
    private List<InvoiceLine> invoiceLines = new();

    private int selectedCustomerId;

    // Invoice-level discount.
    private decimal invoiceDiscountPercent = 0;

    private bool isLoading = true;
    private bool isSaving;
    private bool isSavingCustomer;
    private bool showCustomerForm;

    private bool isDeletingCustomer;
    private bool showDeleteCustomerConfirmation;

    private int customerToDeleteId;
    private string customerToDeleteName = "";

    private string errorMessage = "";
    private string successMessage = "";

    private string newCustomerName = "";
    private string newCustomerEmail = "";
    private string newCustomerPhone = "";

    private HttpClient Api =>
        HttpClientFactory.CreateClient("SalesInvoiceAPI");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            customers = await Api.GetFromJsonAsync<List<CustomerDto>>(
                "api/customers") ?? new();

            products = await Api.GetFromJsonAsync<List<ProductDto>>(
                "api/products") ?? new();

            invoiceLines.Add(new InvoiceLine());
        }
        catch (Exception ex)
        {
            errorMessage = "Could not load API data: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    // Open or close the new customer form.
    private void ToggleCustomerForm()
    {
        if (showCustomerForm)
        {
            CancelCustomerForm();
        }
        else
        {
            errorMessage = "";
            successMessage = "";
            showCustomerForm = true;
        }
    }

    // Clear the customer form without saving.
    private void CancelCustomerForm()
    {
        showCustomerForm = false;
        newCustomerName = "";
        newCustomerEmail = "";
        newCustomerPhone = "";
        errorMessage = "";
    }

    // Create a new customer.
    private async Task SaveCustomer()
    {
        if (isSavingCustomer || isSaving || isDeletingCustomer)
        {
            return;
        }

        errorMessage = "";
        successMessage = "";

        if (string.IsNullOrWhiteSpace(newCustomerName) ||
            string.IsNullOrWhiteSpace(newCustomerEmail) ||
            string.IsNullOrWhiteSpace(newCustomerPhone))
        {
            errorMessage =
                "Please enter the customer's name, email and phone number.";
            return;
        }

        var request = new
        {
            Name = newCustomerName.Trim(),
            Email = newCustomerEmail.Trim(),
            Phone = newCustomerPhone.Trim()
        };

        isSavingCustomer = true;

        try
        {
            var response = await Api.PostAsJsonAsync(
                "api/customers", request);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage =
                    await response.Content.ReadAsStringAsync();
                return;
            }

            var createdCustomer = await response.Content
                .ReadFromJsonAsync<CustomerDto>();

            if (createdCustomer == null)
            {
                errorMessage =
                    "Customer was created, but the response could not be read.";
                return;
            }

            customers.Add(createdCustomer);

            customers = customers
                .OrderBy(c => c.Name)
                .ToList();

            selectedCustomerId = createdCustomer.CustomerId;

            CancelCustomerForm();

            successMessage =
                $"Customer {createdCustomer.Name} created successfully.";
        }
        catch (Exception ex)
        {
            errorMessage =
                "Could not save or read the new customer: " + ex.Message;
        }
        finally
        {
            isSavingCustomer = false;
        }
    }

    // Show deletion confirmation for the selected customer.
    private void ShowDeleteCustomerConfirmation()
    {
        errorMessage = "";
        successMessage = "";

        var customer = customers.FirstOrDefault(
            c => c.CustomerId == selectedCustomerId);

        if (customer == null)
        {
            errorMessage = "Please select a valid customer.";
            return;
        }

        customerToDeleteId = customer.CustomerId;
        customerToDeleteName = customer.Name;

        showDeleteCustomerConfirmation = true;
    }

    // Close the confirmation without deleting.
    private void CancelCustomerDeletion()
    {
        showDeleteCustomerConfirmation = false;
        customerToDeleteId = 0;
        customerToDeleteName = "";
    }

    // Delete the selected customer.
    private async Task DeleteCustomer()
    {
        if (isDeletingCustomer || isSaving ||
            isSavingCustomer || !showDeleteCustomerConfirmation ||
            customerToDeleteId == 0)
        {
            return;
        }

        errorMessage = "";
        successMessage = "";
        isDeletingCustomer = true;

        try
        {
            int idToDelete = customerToDeleteId;
            string nameToDelete = customerToDeleteName;

            var response = await Api.DeleteAsync(
                $"api/customers/{idToDelete}");

            if (!response.IsSuccessStatusCode)
            {
                errorMessage =
                    await response.Content.ReadAsStringAsync();
                return;
            }

            customers.RemoveAll(
                c => c.CustomerId == idToDelete);

            if (selectedCustomerId == idToDelete)
            {
                selectedCustomerId = 0;
            }

            CancelCustomerDeletion();

            successMessage =
                $"Customer {nameToDelete} deleted successfully.";
        }
        catch (Exception ex)
        {
            errorMessage =
                "Could not delete customer: " + ex.Message;
        }
        finally
        {
            isDeletingCustomer = false;
        }
    }

    private void AddLine()
    {
        invoiceLines.Add(new InvoiceLine());
    }

    private void RemoveLine(InvoiceLine line)
    {
        invoiceLines.Remove(line);
    }

    // Calculate original line total before discounts.
    private decimal GetOriginalLineTotal(InvoiceLine line)
    {
        var product = products.FirstOrDefault(
            p => p.ProductId == line.ProductId);

        return (product?.Price ?? 0) * line.Quantity;
    }

    // Calculate how much money the item discount removes.
    private decimal GetItemDiscountAmount(InvoiceLine line)
    {
        decimal originalTotal = GetOriginalLineTotal(line);

        return decimal.Round(
            originalTotal * line.DiscountPercent / 100,
            2,
            MidpointRounding.AwayFromZero);
    }

    // Calculate line total after the item discount.
    private decimal GetLineTotal(InvoiceLine line)
    {
        return GetOriginalLineTotal(line) -
               GetItemDiscountAmount(line);
    }

    // Total before any discounts.
    private decimal OriginalSubtotal =>
        invoiceLines.Sum(GetOriginalLineTotal);

    // Sum of all individual item discounts.
    private decimal TotalItemDiscounts =>
        invoiceLines.Sum(GetItemDiscountAmount);

    // Sum of all discounted line totals.
    private decimal SubtotalAfterItemDiscounts =>
        invoiceLines.Sum(GetLineTotal);

    // Discount applied to the subtotal after item discounts.
    private decimal InvoiceDiscountAmount =>
        decimal.Round(
            SubtotalAfterItemDiscounts * invoiceDiscountPercent / 100,
            2,
            MidpointRounding.AwayFromZero);

    // Apply automatic rounding after both percentage discount levels.
    private decimal TotalBeforeRounding =>
        SubtotalAfterItemDiscounts - InvoiceDiscountAmount;

    // Customer always pays a whole EGP amount (round down).
    private decimal InvoiceTotal =>
        decimal.Floor(TotalBeforeRounding);

    // The piasters removed from the invoice become an extra discount.
    private decimal RoundingDiscount =>
        TotalBeforeRounding - InvoiceTotal;

    private decimal TotalDiscountPercent =>
        OriginalSubtotal > 0
            ?decimal.Round((OriginalSubtotal - InvoiceTotal) / OriginalSubtotal * 100 ,
            2 , MidpointRounding.AwayFromZero):0;

    // Validate discount percentages.
    private bool IsValidDiscount(decimal discount)
    {
        return discount >= 0 &&
               discount <= 100 &&
               decimal.Round(discount, 2) == discount;
    }

    // Create an invoice with item and invoice discounts.
    private async Task CreateInvoiceAsync()
    {
        if (isSaving || isSavingCustomer || isDeletingCustomer ||
            showDeleteCustomerConfirmation)
        {
            return;
        }

        errorMessage = "";
        successMessage = "";

        if (selectedCustomerId == 0)
        {
            errorMessage = "Please select a customer.";
            return;
        }

        if (invoiceLines.Count == 0 ||
            invoiceLines.Any(l => l.ProductId == 0 || l.Quantity <= 0))
        {
            errorMessage = "Select valid products and quantities.";
            return;
        }

        if (!IsValidDiscount(invoiceDiscountPercent))
        {
            errorMessage =
                "Invoice discount must be between 0 and 100 with at most two decimal places.";
            return;
        }

        if (invoiceLines.Any(l =>
            !IsValidDiscount(l.DiscountPercent)))
        {
            errorMessage =
                "Item discounts must be between 0 and 100 with at most two decimal places.";
            return;
        }

        var request = new
        {
            CustomerId = selectedCustomerId,
            DiscountPercent = invoiceDiscountPercent,

            Items = invoiceLines.Select(l => new
            {
                l.ProductId,
                l.Quantity,
                l.DiscountPercent
            }).ToList()
        };

        isSaving = true;

        try
        {
            var response = await Api.PostAsJsonAsync(
                "api/invoices", request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content
                    .ReadFromJsonAsync<CreateInvoiceResponse>();

                successMessage =
                    $"Invoice {result?.InvoiceNumber} created! " +
                    $"Total: EGP {result?.TotalAmount:N2}";

                invoiceLines = new() { new InvoiceLine() };
                selectedCustomerId = 0;
                invoiceDiscountPercent = 0;
            }
            else
            {
                errorMessage =
                    await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Request failed: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    public class CustomerDto
    {
        public int CustomerId { get; set; }
        public string Name { get; set; } = "";
    }

    public class ProductDto
    {
        public int ProductId { get; set; }
        public string Name { get; set; } = "";
        public decimal Price { get; set; }
    }

    public class InvoiceLine
    {
        public int ProductId { get; set; }
        public int Quantity { get; set; } = 1;

        // Defaults to no discount.
        public decimal DiscountPercent { get; set; } = 0;
    }

    public class CreateInvoiceResponse
    {
        public int InvoiceId { get; set; }
        public string InvoiceNumber { get; set; } = "";
        public decimal TotalAmount { get; set; }
        public decimal TotalDiscountPercent {get; set; }
    }
}
