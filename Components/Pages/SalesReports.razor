
@page "/sales-reports"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using System.Globalization
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Sales Reports</PageTitle>

<h1>Sales Transactions Report</h1>
<p class="text-muted">
    View sales transactions and filter by date range or customer.
</p>

<div class="card shadow-sm p-4 mb-4">
    <h5 class="mb-3">Report Filters</h5>

    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">From Date</label>
            <InputDate @bind-Value="fromDate"
                       class="form-control" />
        </div>

        <div class="col-md-4">
            <label class="form-label">To Date</label>
            <InputDate @bind-Value="toDate"
                       class="form-control" />
        </div>

        <div class="col-md-4">
            <label class="form-label">Customer</label>

            <select class="form-select" @bind="selectedCustomerId">
                <option value="0">All Customers</option>

                @foreach (var customer in customers)
                {
                    <option value="@customer.CustomerId">
                        @customer.Name
                    </option>
                }
            </select>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button class="btn btn-primary"
                disabled="@(isLoading || isDeletingAll)"
                @onclick="LoadReport">
            @(isLoading ? "Loading..." : "Generate Report")
        </button>

        <button class="btn btn-outline-secondary"
                disabled="@(isLoading || isDeletingAll)"
                @onclick="ClearFilters">
            Clear Filters
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

@if (report != null)
{
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm p-4 h-100">
                <p class="text-muted mb-2">Total Sales Amount</p>
                <h2 class="text-primary">
                    EGP @report.TotalSalesAmount.ToString("N2")
                </h2>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm p-4 h-100">
                <p class="text-muted mb-2">Total Invoices</p>
                <h2>@report.TotalInvoices</h2>
            </div>
        </div>
    </div>

    <div class="card shadow-sm p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Sales Transactions</h5>

            <span class="badge bg-primary">
                @report.Transactions.Count records
            </span>
        </div>

        @if (report.Transactions.Count == 0)
        {
            <div class="alert alert-info mb-0">
                No transactions found for the selected filters.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Invoice Number</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th>Amount</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var transaction in report.Transactions)
                        {
                            <tr>
                                <td>@transaction.InvoiceNumber</td>
                                <td>
                                    @transaction.InvoiceDate.ToString("dd MMM yyyy")
                                </td>
                                <td>@transaction.CustomerName</td>
                                <td>
                                    EGP @transaction.TotalAmount.ToString("N2")
                                </td>
                                <td>
                                    <a class="btn btn-sm btn-outline-primary"
                                       href="@($"/invoice-details?id={GetInvoiceId(transaction.InvoiceNumber)}")">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Delete All Invoices section -->
    <div class="card shadow-sm p-4 mt-4">
        <h5>Delete All Invoices</h5>

        <p class="text-muted">
            Permanently delete every invoice and its items.
            Customers and products will not be deleted.
        </p>

        <button class="btn btn-outline-danger"
                disabled="@(isLoading || isDeletingAll || report.TotalInvoices == 0)"
                @onclick="ShowDeleteAllConfirmation">
            Delete All Invoices
        </button>

        @if (showDeleteAllConfirmation)
        {
            <div class="alert alert-warning mt-3">
                <p>
                    <strong>Warning:</strong> This action permanently deletes
                    ALL invoices, not just the currently filtered results.
                </p>

                <p>
                    Type <strong>DELETE ALL</strong> to confirm.
                </p>

                <input class="form-control mb-3"
                       placeholder="Type DELETE ALL"
                       @bind="deleteConfirmationText"
                       @bind:event="oninput"
                       disabled="@isDeletingAll" />

                <div class="d-flex gap-2">
                    <button class="btn btn-danger"
                            disabled="@(isDeletingAll || deleteConfirmationText != "DELETE ALL")"
                            @onclick="DeleteAllInvoices">
                        @(isDeletingAll ? "Deleting..." : "Confirm Delete All")
                    </button>

                    <button class="btn btn-secondary"
                            disabled="@isDeletingAll"
                            @onclick="CancelDeleteAll">
                        Cancel
                    </button>
                </div>
            </div>
        }
    </div>
}

@code {
    private DateTime? fromDate;
    private DateTime? toDate;
    private int selectedCustomerId;

    private bool isLoading;
    private bool isDeletingAll;
    private bool showDeleteAllConfirmation;

    private string errorMessage = "";
    private string successMessage = "";
    private string deleteConfirmationText = "";

    private List<CustomerDto> customers = new();
    private SalesReportDto? report;

    private HttpClient Api =>
        HttpClientFactory.CreateClient("SalesInvoiceAPI");

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
        await LoadReport();
    }

    private async Task LoadCustomers()
    {
        try
        {
            customers = await Api.GetFromJsonAsync<List<CustomerDto>>(
                "api/customers") ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = "Could not load customers: " + ex.Message;
        }
    }

    private async Task LoadReport()
    {
        isLoading = true;
        errorMessage = "";
        successMessage = "";
        showDeleteAllConfirmation = false;
        deleteConfirmationText = "";

        try
        {
            var parameters = new List<string>();

            if (fromDate.HasValue)
            {
                parameters.Add(
                    "fromDate=" +
                    fromDate.Value.ToString(
                        "yyyy-MM-dd", CultureInfo.InvariantCulture));
            }

            if (toDate.HasValue)
            {
                parameters.Add(
                    "toDate=" +
                    toDate.Value.ToString(
                        "yyyy-MM-dd", CultureInfo.InvariantCulture));
            }

            if (selectedCustomerId > 0)
            {
                parameters.Add(
                    $"customerId={selectedCustomerId}");
            }

            string url = "api/reports/sales";

            if (parameters.Count > 0)
            {
                url += "?" + string.Join("&", parameters);
            }

            var response = await Api.GetAsync(url);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                report = null;
                return;
            }

            report = await response.Content
                .ReadFromJsonAsync<SalesReportDto>();
        }
        catch (Exception ex)
        {
            report = null;
            errorMessage = "Could not load sales report: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ClearFilters()
    {
        fromDate = null;
        toDate = null;
        selectedCustomerId = 0;

        await LoadReport();
    }

    private void ShowDeleteAllConfirmation()
    {
        errorMessage = "";
        successMessage = "";
        deleteConfirmationText = "";
        showDeleteAllConfirmation = true;
    }

    private void CancelDeleteAll()
    {
        showDeleteAllConfirmation = false;
        deleteConfirmationText = "";
    }

    private async Task DeleteAllInvoices()
    {
        if (isDeletingAll ||
            isLoading ||
            !showDeleteAllConfirmation ||
            deleteConfirmationText != "DELETE ALL")
        {
            return;
        }

        isDeletingAll = true;
        errorMessage = "";
        successMessage = "";

        try
        {
            var response = await Api.DeleteAsync(
                "api/invoices?confirm=true");

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            // Reset filters after deletion
            fromDate = null;
            toDate = null;
            selectedCustomerId = 0;

            report = await Api.GetFromJsonAsync<SalesReportDto>(
                "api/reports/sales");

            successMessage = "All invoices deleted successfully.";

            showDeleteAllConfirmation = false;
            deleteConfirmationText = "";
        }
        catch (Exception ex)
        {
            errorMessage =
                "Could not complete deletion or refresh the report: " +
                ex.Message;
        }
        finally
        {
            isDeletingAll = false;
        }
    }

    private static int GetInvoiceId(string invoiceNumber)
    {
        if (invoiceNumber.StartsWith("INV-") &&
            int.TryParse(invoiceNumber.Substring(4), out int id))
        {
            return id;
        }

        return 0;
    }

    public class CustomerDto
    {
        public int CustomerId { get; set; }
        public string Name { get; set; } = "";
    }

    public class SalesReportDto
    {
        public List<SalesTransactionDto> Transactions { get; set; } = new();
        public decimal TotalSalesAmount { get; set; }
        public int TotalInvoices { get; set; }
    }

    public class SalesTransactionDto
    {
        public string InvoiceNumber { get; set; } = "";
        public DateTime InvoiceDate { get; set; }
        public int CustomerId { get; set; }
        public string CustomerName { get; set; } = "";
        public decimal TotalAmount { get; set; }
    }
}
