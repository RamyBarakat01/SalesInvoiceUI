
@page "/inventory/movements"
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Stock Movement History</PageTitle>

<h1>Stock Movement History</h1>

<p class="text-muted">
    View inventory movements from purchases, sales,
    and stock adjustments.
</p>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

<div class="card shadow-sm p-4 mb-4">
    <h4>Filter Movements</h4>

    <div class="row g-3 align-items-end">

        <div class="col-md-8">
            <label class="form-label">
                Select Product
            </label>

            <select class="form-select"
                    @bind="selectedProductId"
                    disabled="@isLoading">

                <option value="0">
                    All Products
                </option>

                @foreach (var product in products)
                {
                    <option value="@product.ProductId">
                        @product.Name
                    </option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <button class="btn btn-primary w-100"
                    disabled="@isLoading"
                    @onclick="LoadMovements">

                @(isLoading ? "Loading..." : "Search / Refresh")
            </button>
        </div>

    </div>
</div>

@if (isLoading)
{
    <p>Loading stock movements...</p>
}
else if (history != null)
{
    <div class="card shadow-sm p-4">

        <div class="d-flex justify-content-between
                    align-items-center mb-3">

            <h4 class="mb-0">Movement Records</h4>

            <span class="badge bg-primary">
                @history.TotalMovements Movements
            </span>
        </div>

        @if (history.Movements.Count == 0)
        {
            <div class="alert alert-info mb-0">
                No stock movements found.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-striped
                              table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Product</th>
                            <th>Movement Type</th>
                            <th>Reason</th>
                            <th>Quantity Change</th>
                            <th>Unit Cost</th>
                            <th>Source Invoice</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var movement in history.Movements)
                        {
                            <tr>
                                <td>
                                    @movement.MovementDate.ToString(
                                        "dd MMM yyyy HH:mm") UTC
                                </td>

                                <td>
                                    @movement.ProductName
                                </td>

                                <td>
                                    @if (movement.MovementType == "Purchase")
                                    {
                                        <span class="badge bg-success">
                                            Purchase
                                        </span>
                                    }
                                    else if (movement.MovementType == "Sale")
                                    {
                                        <span class="badge bg-danger">
                                            Sale
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @movement.MovementType
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(movement.Reason))
                                    {
                                        @movement.Reason
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>

                                <td>
                                    @if (movement.QuantityChange > 0)
                                    {
                                        <strong class="text-success">
                                            +@movement.QuantityChange
                                        </strong>
                                    }
                                    else if (movement.QuantityChange < 0)
                                    {
                                        <strong class="text-danger">
                                            @movement.QuantityChange
                                        </strong>
                                    }
                                    else
                                    {
                                        <span>0</span>
                                    }
                                </td>

                                <td>
                                    EGP @movement.UnitCost.ToString("N4")
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(
                                        movement.PurchaseInvoiceNumber))
                                    {
                                        <a href="@($"/purchase-invoice-details?id={movement.PurchaseInvoiceId}")">
                                            @movement.PurchaseInvoiceNumber
                                        </a>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(
                                        movement.SalesInvoiceNumber))
                                    {
                                        <a href="@($"/invoice-details?id={movement.InvoiceId}")">
                                            @movement.SalesInvoiceNumber
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Stock Adjustment
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }
    </div>
}

@code {
    private bool isLoading = true;

    private string errorMessage = "";

    private int selectedProductId = 0;

    private List<ProductOptionDto> products = new();

    private StockMovementResponse? history;

    private HttpClient Api =>
        HttpClientFactory.CreateClient("SalesInvoiceAPI");

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
        await LoadMovements();
    }

    private async Task LoadProducts()
    {
        try
        {
            var inventory = await Api
                .GetFromJsonAsync<InventoryProductsResponse>(
                    "api/inventory");

            products = inventory?.Products ?? new();
        }
        catch (Exception ex)
        {
            errorMessage =
                "Could not load product list: " + ex.Message;
        }
    }

    private async Task LoadMovements()
    {
        isLoading = true;
        errorMessage = "";

        try
        {
            string url = selectedProductId > 0
                ? $"api/inventory/movements?productId={selectedProductId}"
                : "api/inventory/movements";

            history = await Api
                .GetFromJsonAsync<StockMovementResponse>(url);
        }
        catch (Exception ex)
        {
            history = null;

            errorMessage =
                "Could not load stock movements: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    public class InventoryProductsResponse
    {
        public List<ProductOptionDto> Products { get; set; } = new();
    }

    public class ProductOptionDto
    {
        public int ProductId { get; set; }

        public string Name { get; set; } = "";
    }

    public class StockMovementResponse
    {
        public int TotalMovements { get; set; }

        public List<StockMovementDto> Movements { get; set; } = new();
    }

    public class StockMovementDto
    {
        public int StockMovementId { get; set; }

        public int ProductId { get; set; }

        public string ProductName { get; set; } = "";

        public int QuantityChange { get; set; }

        public decimal UnitCost { get; set; }

        public string MovementType { get; set; } = "";
        public string? Reason {get; set; } = "";

        public DateTime MovementDate { get; set; }

        public int? PurchaseInvoiceId { get; set; }

        public int? InvoiceId { get; set; }

        public string? PurchaseInvoiceNumber { get; set; }

        public string? SalesInvoiceNumber { get; set; }
    }
}
